{
  "name": "@sideform/browser-agent",
  "version": "0.2.0",
  "private": true,
  "description": "Goal-driven browser agent: page controller, step policy and browse_task loop, decoupled from pen-editor.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./controller": {
      "types": "./dist/controller/index.d.ts",
      "default": "./dist/controller/index.js"
    },
    "./policy": {
      "types": "./dist/policy/index.d.ts",
      "default": "./dist/policy/index.js"
    },
    "./loop": {
      "types": "./dist/loop/index.d.ts",
      "default": "./dist/loop/index.js"
    },
    "./adapters/playwright": {
      "types": "./dist/adapters/playwright.d.ts",
      "default": "./dist/adapters/playwright.js"
    },
    "./adapters/systemone-http": {
      "types": "./dist/adapters/systemoneHttp.d.ts",
      "default": "./dist/adapters/systemoneHttp.js"
    },
    "./adapters/ai-sdk": {
      "types": "./dist/adapters/aiSdk.d.ts",
      "default": "./dist/adapters/aiSdk.js"
    },
    "./adapters/http-backend": {
      "types": "./dist/adapters/httpBackend.d.ts",
      "default": "./dist/adapters/httpBackend.js"
    },
    "./adapters/local-backend": {
      "types": "./dist/adapters/localBackend.d.ts",
      "default": "./dist/adapters/localBackend.js"
    },
    "./adapters/controller-bridge": {
      "types": "./dist/adapters/controllerBridge.d.ts",
      "default": "./dist/adapters/controllerBridge.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "example": "tsx examples/run-task.ts",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "ai": "^6.0.0",
    "playwright-core": "^1.55.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^2.0.81",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "ai": "^6.0.304",
    "eslint": "^9.39.5",
    "happy-dom": "^21.0.1",
    "playwright-core": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  },
  "typesVersions": {
    "*": {
      "controller": [
        "dist/controller/index.d.ts"
      ],
      "policy": [
        "dist/policy/index.d.ts"
      ],
      "loop": [
        "dist/loop/index.d.ts"
      ],
      "adapters/playwright": [
        "dist/adapters/playwright.d.ts"
      ],
      "adapters/systemone-http": [
        "dist/adapters/systemoneHttp.d.ts"
      ],
      "adapters/ai-sdk": [
        "dist/adapters/aiSdk.d.ts"
      ],
      "adapters/http-backend": [
        "dist/adapters/httpBackend.d.ts"
      ],
      "adapters/local-backend": [
        "dist/adapters/localBackend.d.ts"
      ],
      "adapters/controller-bridge": [
        "dist/adapters/controllerBridge.d.ts"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dan-rozhkov/browser-agent.git"
  }
}
